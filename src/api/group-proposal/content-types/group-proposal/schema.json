{
  "kind": "collectionType",
  "collectionName": "group_proposals",
  "info": {
    "singularName": "group-proposal",
    "pluralName": "group-proposals",
    "displayName": "Group Proposal",
    "description": "Student-submitted request to create a new Group, reviewed by a Coordinator"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "category": {
      "type": "string"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "profilePicture": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "memberLimit": {
      "type": "integer",
      "min": 1,
      "required": false
    },
    "responsibleEmail": {
      "type": "email",
      "required": false
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "approved", "rejected"],
      "default": "pending",
      "required": true
    },
    "submittedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::student.student",
      "inversedBy": "submittedGroupProposals"
    },
    "approvedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::student.student",
      "inversedBy": "approvedGroupProposals"
    }
  }
}
